#!/usr/bin/env bash
# mortise.me/install — fetches and runs the CURRENT installer from the source
# repo. This file used to be a checked-in copy of scripts/install.sh and
# drifted months behind, serving already-fixed bugs (CAI-351). A stub cannot
# drift: the source repo is the only place the installer lives.
set -euo pipefail
exec bash <(curl -fsSL https://raw.githubusercontent.com/mortise-org/mortise/main/scripts/install.sh)
